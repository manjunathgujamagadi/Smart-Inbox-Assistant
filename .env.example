# Copy to .env and fill in real values. Never commit the real .env file (it's gitignored).

# Required - Azure OpenAI (gpt-5-mini deployment; gpt-4o-mini also works)
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Real IMAP test mailbox intake (Section 3A) - the primary way mail enters the app.
# Use a dedicated test account (Gmail: enable 2FA, then create an app password).
MAIL_POLLING_ENABLED=true
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_USERNAME=your-test-mailbox@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_INBOX_FOLDER=INBOX
MAIL_POLL_INTERVAL_MS=30000
# Optional ISO date: ignore mail received before this day. Blank = from the day before first startup,
# so connecting a mailbox never ingests its whole history.
MAIL_INGEST_SINCE=
