# Copy to .env and fill in real values. Never commit the real .env file (it's gitignored).

# Required - Azure OpenAI (gpt-4o-mini deployment)
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional - real IMAP test mailbox intake (Section 3A). Leave MAIL_POLLING_ENABLED=false
# to rely on the batch runner (test-data) instead.
MAIL_POLLING_ENABLED=false
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=
